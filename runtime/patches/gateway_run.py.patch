+    _MAESTRO_VISIBILITY_PATH = Path.home() / ".hermes" / "maestro_visibility.json"
+
+    def _load_maestro_visibility(self) -> Dict[str, dict]:
+        """Return dict of agent_id -> {"in": bool, "out": bool}."""
+        try:
+            data = json.loads(self._MAESTRO_VISIBILITY_PATH.read_text())
+        except (FileNotFoundError, json.JSONDecodeError, OSError):
+            return {}
+        if not isinstance(data, dict):
+            return {}
+        return data
+
+    def _get_maestro_visibility(self, agent_id: str) -> dict:
+        """Read per-agent visibility flags for a specific agent."""
+        data = self._load_maestro_visibility()
+        return data.get(agent_id, {"in": False, "out": False})
+
+    def _set_maestro_visibility(self, agent_id: str, key: str, value) -> dict:
+        """Set a visibility flag (key: 'in', 'out', or 'display_mode') for an agent. Returns the new state dict."""
+        data = self._load_maestro_visibility()
+        if agent_id not in data:
+            data[agent_id] = {"in": False, "out": False}
+        if key == "display_mode":
+            # value here is the mode string: "long", "short", or "off"
+            data[agent_id]["display_mode"] = value
+        else:
+            data[agent_id][key] = bool(value)
+        try:
+            self._MAESTRO_VISIBILITY_PATH.parent.mkdir(parents=True, exist_ok=True)
+            self._MAESTRO_VISIBILITY_PATH.write_text(json.dumps(data, indent=2))
+        except Exception:
+            pass
+        return data[agent_id]
+
