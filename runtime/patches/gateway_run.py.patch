+    async def _handle_bb_command(self, event: "MessageEvent") -> str:
+        """Handle /bb [agent] — show one agent's blackboard (last 4h, plain English)."""
+        import json, pathlib, datetime
+        BB_ROOT = _MAESTRO_HOME / "blackboards"
+        args = (event.text or "").strip().split()
+        agent_id = args[1] if len(args) > 1 else None
+        if not agent_id:
+            return "Usage: /bb <agent_id>  (e.g. /bb proteus)\nFor all agents use /bball"
+        p = BB_ROOT / f"{agent_id}_bb.json"
+        if not p.exists():
+            return f"No blackboard found for {agent_id}. They may not have written any BB entries yet."
+        try:
+            entries = json.loads(p.read_text())
+            if not isinstance(entries, list) or not entries:
+                return f"{agent_id} — blackboard is empty."
+            lines = [f"{agent_id} — last 4h activity", "─" * 40]
+            for e in entries:
+                ts_raw = e.get("ts", "")
+                try:
+                    dt = datetime.datetime.fromisoformat(ts_raw.replace("Z", "+00:00"))
+                    ts = dt.strftime("%-I:%M%p").lower()
+                except Exception:
+                    ts = ts_raw[:16]
+                desc = e.get("description", "")
+                status = e.get("status", "")
+                dur = e.get("duration_min")
+                tag = f"[{status}, {dur}min]" if dur else f"[{status}]"
+                lines.append(f"{ts}  {desc}  {tag}")
+            return "\n".join(lines)
+        except Exception as ex:
+            return f"Error reading {agent_id} blackboard: {ex}"
+
+    async def _handle_bball_command(self, event: "MessageEvent") -> str:
+        """Handle /bball — show all agents' blackboards."""
+        import json, pathlib, datetime
+        BB_ROOT = _MAESTRO_HOME / "blackboards"
+        AGENTS = ["songbird", "proteus", "stormtrooper", "hermes", "lexicon", "mnemosyne"]
+        sections = []
+        for agent_id in AGENTS:
+            p = BB_ROOT / f"{agent_id}_bb.json"
+            if not p.exists():
+                continue
+            try:
+                entries = json.loads(p.read_text())
+                if not isinstance(entries, list) or not entries:
+                    continue
+                lines = [f"{agent_id} — last 4h activity", "─" * 40]
+                for e in entries[:5]:  # cap at 5 per agent for readability
+                    ts_raw = e.get("ts", "")
+                    try:
+                        dt = datetime.datetime.fromisoformat(ts_raw.replace("Z", "+00:00"))
+                        ts = dt.strftime("%-I:%M%p").lower()
+                    except Exception:
+                        ts = ts_raw[:16]
+                    desc = e.get("description", "")
+                    status = e.get("status", "")
+                    dur = e.get("duration_min")
+                    tag = f"[{status}, {dur}min]" if dur else f"[{status}]"
+                    lines.append(f"{ts}  {desc}  {tag}")
+                sections.append("\n".join(lines))
+            except Exception:
+                continue
+        if not sections:
+            return "No blackboard entries found for any agent."
+        return "\n\n".join(sections)
+
+    async def _handle_log_command(self, event: "MessageEvent") -> str:
+        """Handle /log [agent] — show one agent's technical work log (last 100 entries)."""
+        import json, pathlib
+        LOG_ROOT = _MAESTRO_HOME / "logs"
+        args = (event.text or "").strip().split()
+        agent_id = args[1] if len(args) > 1 else None
+        if not agent_id:
+            return "Usage: /log <agent_id>  (e.g. /log proteus)"
+        p = LOG_ROOT / f"{agent_id}.jsonl"
+        if not p.exists():
+            return f"No log file found for {agent_id}."
+        try:
+            lines_raw = p.read_text().strip().splitlines()[-100:]
+            entries = []
+            for line in lines_raw:
+                try:
+                    entries.append(json.loads(line))
+                except Exception:
+                    continue
+            if not entries:
+                return f"{agent_id} log is empty."
+            out = [f"{agent_id} — last {len(entries)} log entries", "─" * 40]
+            for e in entries:
+                ts = e.get("ts", "")[:19].replace("T", " ")
+                action = e.get("action", "")
+                params = e.get("params", {})
+                desc = params.get("description", params.get("content", ""))
+                if isinstance(desc, str):
+                    desc = desc[:80]
+                out.append(f"{ts}  [{action}]  {desc}")
+            return "\n".join(out)
+        except Exception as ex:
+            return f"Error reading {agent_id} log: {ex}"
+
+    async def _handle_memory_command(self, event: "MessageEvent") -> str:
+        """Handle /memory [agent] — show one agent's Task Memory summary."""
+        import json, pathlib
+        MEMORY_ROOT = _MAESTRO_HOME / "memory"
+        args = (event.text or "").strip().split()
+        agent_id = args[1] if len(args) > 1 else None
+        if not agent_id:
+            return "Usage: /memory <agent_id>  (e.g. /memory proteus)"
+        p = MEMORY_ROOT / f"{agent_id}_task_memory.json"
+        if not p.exists():
+            return f"No memory file yet for {agent_id}. They may not have run a summarization cron yet."
+        try:
+            m = json.loads(p.read_text())
+            generated = m.get("generated_at", "")[:16].replace("T", " ")
+            stale = " [STALE]" if m.get("stale") else ""
+            summary = m.get("summary", "No summary available.")
+            completed = m.get("completed_items", [])
+            in_progress = m.get("in_progress_items", [])
+            blocked = m.get("blocked_items", [])
+            lines = [
+                f"{agent_id} — Task Memory (generated {generated}{stale})",
+                "─" * 40,
+                summary,
+                "",
+                f"Completed: {', '.join(completed) if completed else 'nothing yet'}",
+                f"In progress: {', '.join(in_progress) if in_progress else 'nothing'}",
+                f"Blocked: {', '.join(blocked) if blocked else 'nothing'}",
+            ]
+            return "\n".join(lines)
+        except Exception as ex:
+            return f"Error reading {agent_id} memory: {ex}"
+
