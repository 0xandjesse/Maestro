+                    f"Done: {', '.join(completed) or 'none'}  |  "
+                    f"In progress: {', '.join(in_progress) or 'none'}"
+                )
+            except Exception:
+                continue
+        if not sections:
+            return "No memory files found for any agent. Run the summarization cron first."
