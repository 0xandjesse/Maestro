+"""
+Append-Only Audit/Event Log for Hermes Agent.
+
+Writes structured JSON lines to ``~/.hermes/audit.jsonl`` (one JSON object per line).
+Each event has: timestamp, event_type, and event-specific data.
+
+Rotation: when the current file exceeds 100 MB, it is renamed to
+``audit.jsonl.1`` (bumping existing rotated files) and a fresh file is started.
+At most 5 rotated files are kept (``audit.jsonl.1`` through ``audit.jsonl.5``).
+
+Usage::
+
+    from agent.audit_log import audit_log
+
+    audit_log.write("agent.start", {"agent_id": "hermes", "pid": 12345})
+    audit_log.write("execution.end", {"execution_id": "abc", "iterations": 5})
+
+This module is import-safe — it has no heavy dependencies and will never
+raise on write failures (errors are logged but never propagated).
+"""
+
+import json
+import logging
+import os
+import threading
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import Any, Dict, Optional
+
+# NOTE: get_hermes_home intentionally NOT used here — audit logs go to
+# ~/.maestro/ regardless of profile, matching the Maestro registry layout.
+
+logger = logging.getLogger(__name__)
+
+# ---------------------------------------------------------------------------
+# Constants
+# ---------------------------------------------------------------------------
+
+_MAX_ROTATED_FILES = 5
+_MAX_FILE_SIZE_BYTES = 100 * 1024 * 1024  # 100 MB
+
+
+class AuditLog:
+    """Thread-safe, append-only JSONL audit log with rotation.
+
+    All writes are serialised through a process-wide lock so that concurrent
+    agent threads (gateway, cron, subagents) never interleave partial lines.
+
+    Event types logged by the system (see tactical-hardening-phase-1.spec):
+      agent.start, agent.stop, execution.start, execution.end,
+      tool.call, tool.result, kill, cap.breach, transport.send,
+      transport.recv, error
+    """
+
+    def __init__(self) -> None:
+        self._lock = threading.Lock()
+        self._path: Optional[Path] = None
+        self._size_checked_at: float = 0.0  # monotonic clock for size checks
+
+    # -- public API ----------------------------------------------------------
+
+    def write(self, event_type: str, data: Dict[str, Any]) -> None:
+        """Append an audit event. Never raises on I/O errors."""
+        try:
+            entry = {
+                "ts": datetime.now(timezone.utc).isoformat(),
+                "event": event_type,
+                **data,
+            }
+            line = json.dumps(entry, ensure_ascii=False, sort_keys=True) + "\n"
+            self._append(line)
+        except Exception:
+            logger.debug("audit_log.write failed for %s", event_type, exc_info=True)
+
+    def write_cap_breach(
+        self,
+        execution_id: str,
+        cap_type: str,
+        limit: int,
+        actual: int,
+    ) -> None:
+        """Convenience method for logging an execution cap breach.
+
+        Called from run_agent.py when Priority 2 execution caps are enforced.
+        The cap_type should be one of: max_iterations, max_wall_clock_s,
+        max_tokens, max_cost_cents.
+        """
+        self.write("cap.breach", {
+            "execution_id": execution_id,
+            "cap_type": cap_type,
+            "limit": limit,
+            "actual": actual,
+        })
+
+    def write_error(
+        self,
+        execution_id: str,
+        error_type: str,
+        error_message: str,
+        stack_trace_hash: str = "",
+    ) -> None:
+        """Convenience method for logging an execution error."""
+        self.write("error", {
+            "execution_id": execution_id,
+            "error_type": error_type,
+            "error_message": error_message[:200] if error_message else "",
+            "stack_trace_hash": stack_trace_hash,
+        })
+
+    # -- internal ------------------------------------------------------------
+
+    def _get_path(self) -> Path:
+        """Lazily resolve and create the audit log path.
+
+        Uses ``~/.maestro/audit.jsonl`` as the canonical location,
+        matching the Maestro process registry and transport config.
+        This is separate from HERMES_HOME so audit data survives
+        across profile switches.
+        """
+        if self._path is None:
+            audit_dir = Path.home() / ".maestro"
+            audit_dir.mkdir(parents=True, exist_ok=True)
+            self._path = audit_dir / "audit.jsonl"
+        return self._path
+
+    def _append(self, line: str) -> None:
+        """Write a line to the JSONL file, with rotation check."""
+        with self._lock:
+            path = self._get_path()
+            # Rotate if needed (check at most once per second to avoid stat storms)
+            now = _import_monotonic()()
+            if now - self._size_checked_at > 1.0:
+                self._size_checked_at = now
+                self._maybe_rotate(path)
+            with open(path, "a", encoding="utf-8") as fh:
+                fh.write(line)
+
+    def _maybe_rotate(self, path: Path) -> None:
+        """Rotate the log file if it exceeds the size limit."""
+        try:
+            if not path.exists():
+                return
+            size = path.stat().st_size
+        except OSError:
+            return
+
+        if size < _MAX_FILE_SIZE_BYTES:
+            return
+
+        # Perform rotation: audit.jsonl.5 is deleted, .4→.5, .3→.4, … .1→.2
+        parent = path.parent
+        for i in range(_MAX_ROTATED_FILES, 0, -1):
+            rotated = parent / f"audit.jsonl.{i}"
+            next_num = i + 1
+            if next_num > _MAX_ROTATED_FILES:
+                # Delete the oldest rotated file
+                try:
+                    rotated.unlink()
+                except FileNotFoundError:
+                    pass
+            else:
+                target = parent / f"audit.jsonl.{next_num}"
+                try:
+                    # On rename, target may not exist — that's fine
+                    if rotated.exists():
+                        rotated.replace(target)
+                except OSError:
+                    pass
+
+        # Move current file to .1
+        target_1 = parent / "audit.jsonl.1"
+        try:
+            path.replace(target_1)
+        except OSError:
+            pass
+
+
+def _import_monotonic():
+    """Lazy import of time.monotonic to keep module import light."""
+    from time import monotonic
+    return monotonic
+
+
+# Module-level singleton — the canonical audit log instance.
+audit_log = AuditLog()
